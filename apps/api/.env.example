DATABASE_URL=postgresql://fleek:fleek_dev_password@localhost:5432/fleek_iprs
JWT_SECRET=dev-jwt-secret-change-in-production
FIELD_ENCRYPTION_KEY=dev-only-field-key-change-me
PORT=4000
# Dev default: full sandbox catalog (24 checks via the deterministic mock).
# Narrow this in staging/prod to gate availability deployment-wide — per-org
# rows can only opt out, never re-enable a check missing here.
ENABLED_CHECKS=iprs_standard,match_id_phone,employer_verification,face_id_match,bank_account_verification,alien_id,aml_pep_screen,passport_check,sim_swap_check,kplc_location_checker,kra_pin_verification,search_name_by_phone,search_phones_by_id,motor_vehicle_ownership,drivers_license_verification,metropol_score_only,metropol_standard_report,metropol_full_report,creditinfo_score_only,creditinfo_comprehensive,creditinfo_crb_status,brs,spin_score_only,scanned_statement

# --- Live verification upstream (leave empty for full sandbox) ---
USE_LIVE_UPSTREAM=false
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
# Which checks route to the live upstream when it is configured:
LIVE_CHECKS=iprs_standard,kra_pin_verification

# --- M-Pesa Daraja STK Push (leave empty to use the mock gateway) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=https://api.fleekiprs.co.ke/v1/payments/callback

# --- Card via Stripe (leave empty for sandbox auto-complete) ---
STRIPE_SECRET_KEY=

# --- PayPal Orders v2 (leave empty for sandbox auto-complete) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# PayPal has no KES support — live orders charge this currency instead.
PAYPAL_CURRENCY=USD

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PASSWORD_RESET_URL=http://localhost:3001/reset-password

# --- SMTP mail (leave SMTP_HOST empty for log-only ConsoleMailer) ---
# Works with Postmark, SES (SMTP interface), Gmail, or self-hosted Postfix.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fleek IPRS <no-reply@fleekiprs.co.ke>
