DATABASE_URL=postgresql://fleek:fleek_dev_password@localhost:5432/fleek_iprs
JWT_SECRET=dev-jwt-secret-change-in-production
FIELD_ENCRYPTION_KEY=dev-only-field-key-change-me
PORT=4000
ENABLED_CHECKS=iprs_standard,kra_pin_verification,match_id_phone,sim_swap_check

# --- Live verification upstream (leave empty for full sandbox) ---
USE_LIVE_UPSTREAM=false
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
# Which checks route to the live upstream when it is configured:
LIVE_CHECKS=iprs_standard,kra_pin_verification

# --- M-Pesa Daraja STK Push (leave empty to use the mock gateway) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=https://api.fleekiprs.co.ke/v1/payments/callback

# --- Card via Stripe (leave empty for sandbox auto-complete) ---
STRIPE_SECRET_KEY=

# --- PayPal Orders v2 (leave empty for sandbox auto-complete) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# PayPal has no KES support — live orders charge this currency instead.
PAYPAL_CURRENCY=USD

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PASSWORD_RESET_URL=http://localhost:3001/reset-password

# --- SMTP mail (leave SMTP_HOST empty for log-only ConsoleMailer) ---
# Works with Postmark, SES (SMTP interface), Gmail, or self-hosted Postfix.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fleek IPRS <no-reply@fleekiprs.co.ke>
