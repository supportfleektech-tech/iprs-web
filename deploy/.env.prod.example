# Production secrets for Fleek IPRS — copy to .env and fill in.
# NEVER commit the real .env.

POSTGRES_USER=fleek
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=fleek_iprs

# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# --- Live verification upstream (optional; sandbox while empty) ---
USE_LIVE_UPSTREAM=false
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
LIVE_CHECKS=iprs_id,kra_pin

# --- M-Pesa Daraja (optional; mock gateway while empty) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=https://api.fleekiprs.co.ke/v1/payments/callback
