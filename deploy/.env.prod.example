# Production secrets for Fleek IPRS — copy to .env and fill in.
# NEVER commit the real .env.

POSTGRES_USER=fleek
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=fleek_iprs

# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# --- Live verification upstream (optional; sandbox while empty) ---
USE_LIVE_UPSTREAM=false
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
LIVE_CHECKS=iprs_standard,kra_pin_verification

# --- M-Pesa Daraja (optional; mock gateway while empty) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=https://api.fleekiprs.co.ke/v1/payments/callback

# --- Backup upstream (optional; explicit opt-in retry only) ---
BACKUP_BASE_URL=
BACKUP_API_KEY=
BACKUP_CHECKS=

# --- Card via Stripe (optional; sandbox auto-complete while empty) ---
STRIPE_SECRET_KEY=

# --- PayPal Orders v2 (optional; sandbox auto-complete while empty) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# PayPal has no KES support — live orders charge this currency instead.
PAYPAL_CURRENCY=USD

# --- SMTP mail (optional; log-only ConsoleMailer while SMTP_HOST empty) ---
# Works with Postmark, SES (SMTP interface), Gmail, or self-hosted Postfix.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fleek IPRS <no-reply@fleekiprs.co.ke>
