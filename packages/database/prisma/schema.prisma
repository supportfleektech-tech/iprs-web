generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum VerificationType {
  iprs_standard
  match_id_phone
  employer_verification
  face_id_match
  bank_account_verification
  alien_id
  aml_pep_screen
  passport_check
  sim_swap_check
  kplc_location_checker
  kra_pin_verification
  search_name_by_phone
  search_phones_by_id
  motor_vehicle_ownership
  drivers_license_verification
  metropol_score_only
  metropol_standard_report
  metropol_full_report
  creditinfo_score_only
  creditinfo_comprehensive
  creditinfo_crb_status
  brs
  spin_score_only
  scanned_statement
}

enum VerificationStatus {
  pending
  success
  not_found
  failed
}

enum TransactionType {
  topup
  charge
  refund
}

enum TopUpStatus {
  pending
  approved
  rejected
}

enum ApiKeyEnv {
  live
  test
}

enum PaymentMethod {
  stk
  bank
  card
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  apiKeys      ApiKey[]
  wallet       Wallet?
  topUpRequests TopUpRequest[]
  verifications VerificationRequest[]
  batches       VerificationBatch[]

  @@map("organizations")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(MEMBER)
  isPlatformAdmin Boolean @default(false)
  organizationId String?
  failedLoginAttempts Int  @default(0)
  lockedUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id])
  refreshTokens RefreshToken[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

/// Opaque rotating refresh tokens; hashed at rest, single-use,
/// with reuse detection revoking the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  hashedToken  String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Audit pointer to the token that superseded this one.
  rotatedToId  String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  prefix         String
  hashedKey      String    @unique
  environment    ApiKeyEnv @default(test)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  organizationId String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

model Wallet {
  id             String @id @default(cuid())
  organizationId String @unique
  balanceMinor   BigInt @default(0)
  currency       String @default("KES")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType
  amountMinor   BigInt
  balanceAfter  BigInt
  reference     String?
  description   String?
  walletId      String
  verificationId String? @unique
  createdAt     DateTime        @default(now())

  wallet       Wallet               @relation(fields: [walletId], references: [id])
  verification VerificationRequest? @relation(fields: [verificationId], references: [id])

  @@index([walletId, createdAt])
  @@map("transactions")
}

model TopUpRequest {
  id             String      @id @default(cuid())
  organizationId String
  requestedById  String
  amountMinor    BigInt
  status         TopUpStatus @default(pending)
  adminNote      String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("top_up_requests")
}

model VerificationRequest {
  id                 String            @id @default(cuid())
  type               VerificationType
  status             VerificationStatus @default(pending)
  source             String
  encryptedInput     String
  encryptedResult    String?
  costMinor          BigInt            @default(0)
  latencyMs          Int?
  errorMessage       String?
  consent            Boolean           @default(false)
  consentCollectedBy String?
  cbConsent          Boolean           @default(false)
  isBackup           Boolean           @default(false)
  organizationId     String
  userId             String?
  apiKeyId           String?
  batchId            String?
  createdAt          DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction?
  batch        VerificationBatch? @relation(fields: [batchId], references: [id])

  @@index([organizationId, createdAt])
  @@index([type, status])
  @@index([batchId])
  @@map("verification_requests")
}

/// A bulk CSV run. Processing happens in-process; rows are individual
/// VerificationRequests linked back to this batch.
model VerificationBatch {
  id             String           @id @default(cuid())
  type           VerificationType
  status         String           @default("processing")
  totalRows      Int
  processedRows  Int              @default(0)
  successCount   Int              @default(0)
  failedCount    Int              @default(0)
  notFoundCount  Int              @default(0)
  errorMessage   String?
  isBackup       Boolean          @default(false)
  organizationId String
  userId         String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     VerificationRequest[]

  @@index([organizationId, createdAt])
  @@map("verification_batches")
}

model ProductPricing {
  id         String           @id @default(cuid())
  type       VerificationType @unique
  priceMinor BigInt
  active     Boolean          @default(true)
  updatedAt  DateTime         @updatedAt

  @@map("product_pricing")
}

model ProductPricingTier {
  id                String           @id @default(cuid())
  productType       VerificationType @map("product_type")
  minVolume         Int              @map("min_volume")
  maxVolume         Int?             @map("max_volume")
  unitPriceMinor    BigInt           @map("unit_price_minor")
  backupPriceMinor  BigInt?          @map("backup_price_minor")
  vatExclusive      Boolean          @default(true) @map("vat_exclusive")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([productType, minVolume])
  @@index([productType])
  @@map("product_pricing_tiers")
}

model OrganizationMonthlyUsage {
  orgId        String           @map("org_id")
  month        String           // "2026-08"
  productType  VerificationType @map("product_type")
  successCount Int              @default(0) @map("success_count")

  @@id([orgId, month, productType])
  @@map("organization_monthly_usage")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorType String   @default("user")
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

/// M-Pesa STK Push / Bank Transfer / Card initiated by an org user.
/// On success (callback or poll) the wallet is credited and a ledger entry written.
model StkPayment {
  id                String         @id @default(cuid())
  organizationId    String
  userId            String
  amountMinor       BigInt
  phone             String
  method            PaymentMethod  @default(stk)
  status            String         @default("pending")
  merchantRequestId String?
  checkoutRequestId String?        @unique
  mpesaReceipt      String?
  resultDesc        String?
  paybillRef        String?        // For bank transfer confirmations
  createdAt         DateTime       @default(now())
  completedAt       DateTime?

  @@index([organizationId, createdAt])
  @@index([checkoutRequestId])
  @@map("stk_payments")
}
